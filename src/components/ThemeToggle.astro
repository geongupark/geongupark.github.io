---
---
<button id="theme-toggle" type="button" aria-label="테마 전환" title="테마 전환">
  <svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.5" />
    <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6" />
    </g>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M20 14.2A8.2 8.2 0 1 1 9.8 4a6.6 6.6 0 0 0 10.2 10.2Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
  </svg>
</button>

<style>
  button {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 1px solid transparent;
    cursor: pointer;
    color: var(--fg-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  button:hover { color: var(--fg); border-color: var(--line); }
  .moon { display: none; }
  :global(:root[data-theme='dark']) .moon { display: block; }
  :global(:root[data-theme='dark']) .sun { display: none; }
</style>

<script>
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
