---
import { formatDate, readingTime } from '../utils/posts';
import type { Post } from '../utils/posts';

interface Props { post: Post; showDescription?: boolean }
const { post, showDescription = true } = Astro.props;
const { title, description, date, category, draft } = post.data;
---

<article>
  <a class="plain" href={`/posts/${post.id}`}>
    <div class="meta mono">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{category}</span>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)}분</span>
      {draft && <span class="draft">DRAFT</span>}
    </div>
    <h2>{title}</h2>
    {showDescription && <p class="desc">{description}</p>}
  </a>
</article>

<style>
  article { border-bottom: var(--rule); }
  a { display: block; padding-block: 1.6rem; }
  a:hover h2 { text-decoration: underline; text-underline-offset: 0.22em; }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: var(--text-xs);
    color: var(--fg-faint);
    letter-spacing: 0.02em;
  }
  .draft {
    border: 1px solid var(--line-strong);
    color: var(--fg);
    padding-inline: 0.3em;
    letter-spacing: var(--tracking-wide);
  }

  h2 {
    font-size: var(--text-xl);
    margin-top: 0.4rem;
  }

  .desc {
    margin-top: 0.4rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
