---
import { slugify } from '../utils/posts';
interface Props { tags: string[] }
const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags">
    {tags.map((tag) => (
      <li><a class="plain" href={`/tags/${slugify(tag)}`}>#{tag}</a></li>
    ))}
  </ul>
)}

<style>
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0; }
  a {
    display: inline-block;
    border: var(--rule);
    padding: 0.1rem 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-muted);
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  a:hover { border-color: var(--line-strong); color: var(--fg); }
</style>
