---
---
<button id="search-open" type="button" aria-label="Open search">
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
    <circle cx="10.8" cy="10.8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="label">Search</span>
  <kbd class="hint">⌘K</kbd>
</button>

<dialog id="search-dialog" aria-label="Site search">
  <div class="field">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <circle cx="10.8" cy="10.8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <input id="search-input" type="search" autocomplete="off" spellcheck="false"
           placeholder="Search titles, content, and tags" aria-label="Search query" />
    <kbd>ESC</kbd>
  </div>
  <div id="search-results" role="listbox" aria-live="polite"></div>
  <footer>
    <span><kbd>↑</kbd><kbd>↓</kbd> to navigate</span>
    <span><kbd>↵</kbd> to open</span>
  </footer>
</dialog>

<style>
  #search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2rem;
    padding-inline: 0.55rem;
    background: none;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    cursor: pointer;
    font-size: var(--text-sm);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  #search-open:hover { color: var(--fg); border-color: var(--line-strong); }
  #search-open .label { display: none; }
  #search-open .hint {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-faint);
    display: none;
  }
  @media (min-width: 40rem) {
    #search-open .label, #search-open .hint { display: inline; }
  }

  dialog {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100dvh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--line-strong);
    display: none;
    flex-direction: column;
    overflow: hidden;
  }
  dialog[open] { display: flex; }
  dialog::backdrop { background: rgb(0 0 0 / 0.4); backdrop-filter: blur(2px); }

  .field {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-bottom: var(--rule);
    color: var(--fg-faint);
    flex: none;
  }
  .field input {
    flex: 1;
    border: 0;
    background: none;
    outline: none;
    font-size: var(--text-lg);
  }
  .field input::-webkit-search-cancel-button { display: none; }

  #search-results { overflow-y: auto; flex: 1; }

  #search-results :global(a) {
    display: block;
    padding: 0.85rem 1rem;
    border-bottom: var(--rule);
    text-decoration: none;
  }
  #search-results :global(a:hover),
  #search-results :global(a[aria-selected='true']) { background: var(--bg-subtle); }
  #search-results :global(.r-title) { font-weight: 600; letter-spacing: var(--tracking-tight); }
  #search-results :global(.r-meta) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--fg-faint);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  #search-results :global(.r-excerpt) {
    font-size: var(--text-sm);
    color: var(--fg-muted);
    line-height: 1.6;
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #search-results :global(mark) {
    background: none;
    color: var(--fg);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  #search-results :global(.r-empty) {
    padding: 2.5rem 1rem;
    text-align: center;
    color: var(--fg-faint);
    font-size: var(--text-sm);
  }

  dialog footer {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1rem;
    border-top: var(--rule);
    font-size: var(--text-xs);
    color: var(--fg-faint);
    flex: none;
  }
  kbd {
    font-family: var(--font-mono);
    border: var(--rule);
    padding: 0 0.3em;
    margin-right: 0.15em;
  }
</style>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const list = document.getElementById('search-results');
  const openBtn = document.getElementById('search-open');
  if (!dialog || !input || !list) throw new Error('search markup missing');

  let engine: any = null;
  let loading: Promise<any> | null = null;
  let cursor = -1;

  // The pagefind bundle is produced by the pagefind CLI after `astro build`.
  // Bundlers cannot resolve that path, so hand the specifier straight to the browser.
  const importModule = new Function('src', 'return import(src)') as (src: string) => Promise<any>;

  /** Loaded once, the first time the dialog opens. */
  function loadEngine() {
    if (loading) return loading;
    loading = (async () => {
      const mod = await importModule(new URL('/pagefind/pagefind.js', location.origin).href);
      await mod.options({ excerptLength: 26 });
      await mod.init();
      return mod;
    })().catch(() => null);
    return loading;
  }

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  function setMessage(message: string) {
    list!.innerHTML = `<p class="r-empty">${escapeHtml(message)}</p>`;
  }

  function moveCursor(step: number) {
    const items = [...list!.querySelectorAll('a')];
    if (!items.length) return;
    items[cursor]?.setAttribute('aria-selected', 'false');
    cursor = (cursor + step + items.length) % items.length;
    const active = items[cursor]!;
    active.setAttribute('aria-selected', 'true');
    active.scrollIntoView({ block: 'nearest' });
  }

  async function run(query: string) {
    cursor = -1;
    if (!query.trim()) {
      setMessage('Type to search.');
      return;
    }
    engine ??= await loadEngine();
    if (!engine) {
      setMessage('Search index not found. Run `npm run build`, then `npm run preview`.');
      return;
    }
    const { results } = await engine.search(query);
    if (!results.length) {
      setMessage(`No results for "${query}".`);
      return;
    }
    const data = await Promise.all(results.slice(0, 8).map((r: any) => r.data()));
    list!.innerHTML = data
      .map((d: any) => {
        const meta = [d.meta?.category, d.meta?.date].filter(Boolean).map(escapeHtml).join(' · ');
        return `<a href="${d.url}" role="option" aria-selected="false">
          ${meta ? `<div class="r-meta">${meta}</div>` : ''}
          <div class="r-title">${escapeHtml(d.meta?.title ?? 'Untitled')}</div>
          <div class="r-excerpt">${d.excerpt}</div>
        </a>`;
      })
      .join('');
  }

  let timer: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    clearTimeout(timer);
    const value = input.value;
    timer = setTimeout(() => void run(value), 140);
  });

  function open() {
    if (dialog!.open) return;
    dialog!.showModal();
    input!.value = '';
    setMessage('Type to search.');
    input!.focus();
    void loadEngine();
  }

  openBtn?.addEventListener('click', open);

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });

  dialog.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') { event.preventDefault(); moveCursor(1); }
    else if (event.key === 'ArrowUp') { event.preventDefault(); moveCursor(-1); }
    else if (event.key === 'Enter') {
      const active = list!.querySelector('a[aria-selected="true"]') as HTMLAnchorElement | null;
      if (active) { event.preventDefault(); active.click(); }
    }
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const typing = target?.matches('input, textarea, [contenteditable]');
    if ((event.key === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing)) {
      event.preventDefault();
      open();
    }
  });
</script>
