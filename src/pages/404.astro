---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="페이지를 찾을 수 없습니다." noindex>
  <div class="page wrap">
    <p class="eyebrow">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p class="muted">주소가 바뀌었거나 삭제된 글일 수 있습니다.</p>
    <p class="links"><a href="/">홈으로</a> · <a href="/posts">글 목록</a></p>
  </div>
</BaseLayout>

<style>
  .wrap { padding-block: 8rem 6rem; max-width: var(--measure); }
  h1 { font-size: var(--text-2xl); margin-block: 0.75rem 1rem; }
  .links { margin-top: 2rem; font-size: var(--text-sm); }
</style>
