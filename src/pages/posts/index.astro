---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostItem from '../../components/PostItem.astro';
import Pagination from '../../components/Pagination.astro';
import { getPosts } from '../../utils/posts';
import { SITE } from '../../config';

const posts = await getPosts();
const totalPages = Math.max(1, Math.ceil(posts.length / SITE.postsPerPage));
const items = posts.slice(0, SITE.postsPerPage);
---

<BaseLayout title="Posts" description={`${SITE.title}의 글 ${posts.length}편`}>
  <div class="page">
    <PageHeader eyebrow="Archive" title="Posts" description={`전체 ${posts.length}편`} />
    {items.map((post) => <PostItem post={post} />)}
    <Pagination current={1} total={totalPages} next={totalPages > 1 ? '/posts/page/2' : undefined} />
  </div>
</BaseLayout>
